# Required. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Which model backend to use: ollama (default, local) or gateway (hosted).
LLM_BACKEND=ollama
LLM_TIMEOUT=60

# Ollama backend
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Gateway backend
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_PROVIDER=
LLM_WORKSPACE_ID=

# Written by aitsm-bootstrap, leave empty
MCP_SYSTEM_USER_ID=

# Defaults resolve to the project root; set these only to move them elsewhere.
# DATABASE_URL=
# CHROMA_PATH=
